<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HealthTrackApp.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="SettingsPage">
    <Shell.TitleView>
        <Grid
            Padding="10"
            ColumnDefinitions="*,auto,auto,auto"
            ColumnSpacing="10"
            HeightRequest="70"
            HorizontalOptions="Start"
            WidthRequest="400">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="24"
                Text="Settings"
                TextColor="{StaticResource Secondary}"
                VerticalOptions="Center" />

            <ImageButton
                Grid.Row="0"
                Grid.Column="4"
                HeightRequest="50"
                HorizontalOptions="End"
                Source="profile.png"
                WidthRequest="50" />
        </Grid>
    </Shell.TitleView>
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="22">

            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Preferences"
                TextColor="{StaticResource PrimaryDark}" />

            <Border
                Padding="16"
                BackgroundColor="#F8FAFA"
                Stroke="#E4E9E9"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="18">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Activity Reminders"
                                TextColor="{StaticResource PrimaryDark}" />
                            <Label
                                FontSize="13"
                                Text="Remind me to stay active"
                                TextColor="{StaticResource PrimaryDark}" />
                        </VerticalStackLayout>

                        <Switch
                            x:Name="ActivityRemindersSwitch"
                            Grid.Column="1"
                            IsToggled="True"
                            OnColor="{StaticResource Secondary}"
                            ThumbColor="{StaticResource PrimaryDark}"
                            VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E4E9E9" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Sleep Reminders"
                                TextColor="{StaticResource PrimaryDark}" />
                            <Label
                                FontSize="13"
                                Text="Remind me about my sleep target"
                                TextColor="{StaticResource PrimaryDark}" />
                        </VerticalStackLayout>

                        <Switch
                            x:Name="SleepRemindersSwitch"
                            Grid.Column="1"
                            IsToggled="True"
                            OnColor="{StaticResource Secondary}"
                            ThumbColor="{StaticResource PrimaryDark}"
                            VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E4E9E9" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Goal Notifications"
                                TextColor="{StaticResource PrimaryDark}" />
                            <Label
                                FontSize="13"
                                Text="Notify me about goal progress"
                                TextColor="{StaticResource PrimaryDark}" />
                        </VerticalStackLayout>

                        <Switch
                            x:Name="GoalNotificationsSwitch"
                            Grid.Column="1"
                            IsToggled="True"
                            OnColor="{StaticResource Secondary}"
                            ThumbColor="{StaticResource PrimaryDark}"
                            VerticalOptions="Center" />
                    </Grid>



                </VerticalStackLayout>
            </Border>
            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Measurement Units"
                TextColor="{StaticResource PrimaryDark}" />

            <Border
                Padding="16"
                BackgroundColor="#F8FAFA"
                Stroke="#E4E9E9"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*,145" ColumnSpacing="12">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="4"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Distance"
                                TextColor="{StaticResource PrimaryDark}" />

                            <Label
                                FontSize="13"
                                Text="Choose your preferred distance unit"
                                TextColor="{StaticResource PrimaryDark}" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            Padding="8,0"
                            BackgroundColor="#CEE3E1"
                            HeightRequest="46"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            VerticalOptions="Center">

                            <Picker
                                x:Name="DistanceUnitPicker"
                                Title="Select unit"
                                FontSize="13"
                                HorizontalOptions="Fill"
                                SelectedIndex="0"
                                TextColor="{StaticResource PrimaryDark}"
                                VerticalOptions="Center">

                                <Picker.Items>
                                    <x:String>Kilometres</x:String>
                                    <x:String>Miles</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E4E9E9" />

                    <Grid ColumnDefinitions="*,145" ColumnSpacing="12">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="4"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Weight"
                                TextColor="{StaticResource PrimaryDark}" />

                            <Label
                                FontSize="13"
                                Text="Choose your preferred weight unit"
                                TextColor="{StaticResource PrimaryDark}" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            Padding="8,0"
                            BackgroundColor="#CEE3E1"
                            HeightRequest="46"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            VerticalOptions="Center">

                            <Picker
                                x:Name="WeightUnitPicker"
                                Title="Select unit"
                                FontSize="13"
                                HorizontalOptions="Fill"
                                SelectedIndex="0"
                                TextColor="{StaticResource PrimaryDark}"
                                VerticalOptions="Center">

                                <Picker.Items>
                                    <x:String>Kilograms</x:String>
                                    <x:String>Pounds</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </Border>
            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Help and Support"
                TextColor="{StaticResource PrimaryDark}" />

            <Border
                Padding="14"
                BackgroundColor="#F8FAFA"
                Stroke="#E4E9E9"
                StrokeShape="RoundRectangle 16">

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border
                        BackgroundColor="#DFD8F7"
                        HeightRequest="42"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="42">
                        <Image
                            HeightRequest="23"
                            HorizontalOptions="Center"
                            Source="help.png"
                            VerticalOptions="Center"
                            WidthRequest="23" />
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Help and FAQ"
                            TextColor="#242424" />
                        <Label
                            FontSize="13"
                            Text="Find answers to common questions"
                            TextColor="#777777" />
                    </VerticalStackLayout>

                </Grid>
            </Border>

            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="About"
                TextColor="{StaticResource PrimaryDark}" />

            <Border
                Padding="0"
                BackgroundColor="#F8FAFA"
                Stroke="#E4E9E9"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="0">

                    <Grid
                        Padding="16"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="auto,auto"
                        RowSpacing="5">

                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Privacy and Data"
                            TextColor="{StaticResource PrimaryDark}"
                            VerticalOptions="Center" />

                    </Grid>

                    <VerticalStackLayout
                        x:Name="PrivacyContent"
                        Padding="16,0,16,16"
                        IsVisible="True"
                        Spacing="8">

                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="Health Information"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            FontSize="13"
                            Text="HealthTrack is designed to help you monitor your activity and health measurements. Only collect and store the information required for the app's features."
                            TextColor="#666666" />

                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="Your Data"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            FontSize="13"
                            Text="In the completed app, data management options can let you review or delete stored information. Actual storage and deletion behaviour depends on the implemented backend."
                            TextColor="#666666" />

                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#E4E9E9" />

                    <Grid
                        Padding="16"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">

                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="About HealthTrack"
                            TextColor="{StaticResource PrimaryDark}"
                            VerticalOptions="Center" />


                    </Grid>

                    <VerticalStackLayout
                        x:Name="AboutContent"
                        Padding="16,0,16,16"
                        IsVisible="True"
                        Spacing="8">

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="HealthTrack"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            FontSize="13"
                            Text="Your personal health and activity tracking companion."
                            TextColor="#666666" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                FontSize="13"
                                Text="App Version"
                                TextColor="#666666" />

                            <Label
                                Grid.Column="1"
                                FontSize="13"
                                Text="1.0.0"
                                TextColor="#666666" />
                        </Grid>

                        <Label
                            FontSize="13"
                            Text="Developed as a student software project."
                            TextColor="#666666" />

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>