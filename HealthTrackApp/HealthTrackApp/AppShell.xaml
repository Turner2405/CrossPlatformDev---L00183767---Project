<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HealthTrackApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HealthTrackApp.Pages"
    Title="HealthTrackApp"
    Shell.NavBarIsVisible="true"
    Shell.BackgroundColor="{StaticResource PrimaryDark}"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.TabBarBackgroundColor="{StaticResource Secondary}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}">


    <Shell.TitleView>
    <Grid ColumnDefinitions="*,auto"
              Padding="10"
              ColumnSpacing="10">
        <Label Grid.Column="0"  Text="HealthTrack"
                   FontSize="24"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="white"/>
        <Border Grid.Column ="1" StrokeShape="RoundRectangle 15" MaximumWidthRequest="50" Stroke="{StaticResource Primary}">
            <Button 
                    FontAttributes="Bold"
                    FontSize="12"
                    BackgroundColor="{StaticResource Secondary}"
                    ImageSource="profile.png"
                    Clicked="OnProfileClicked"
                    />
        </Border>
    </Grid>
</Shell.TitleView>

<TabBar>
    <ShellContent Title="Home" Icon="house.png"
         ContentTemplate="{DataTemplate local:DashBoard}"
         Route="DashBoard" />
    <ShellContent Title="Statistics" Icon="stats.png"
                     
         />
    <ShellContent Title="Goals" Icon="goals.png"
         />
    <ShellContent Title="Settings" Icon="settings.png"
         />
</TabBar>
    
</Shell>