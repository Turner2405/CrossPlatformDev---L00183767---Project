<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HealthTrackApp.Pages.StatisticsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="StatisticsPage">

    <Shell.TitleView>
        <Grid
            Padding="10"
            ColumnDefinitions="*,auto,auto,auto"
            ColumnSpacing="10"
            HeightRequest="70"
            HorizontalOptions="Start"
            WidthRequest="400">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="24"
                Text="Statistics"
                TextColor="{StaticResource Secondary}"
                VerticalOptions="Center" />

            <ImageButton
                Grid.Row="0"
                Grid.Column="4"
                Clicked="OnProfileClicked"
                HeightRequest="50"
                HorizontalOptions="End"
                Source="profile.png"
                WidthRequest="50" />
        </Grid>
    </Shell.TitleView>
    <ScrollView>

        <VerticalStackLayout HorizontalOptions="Center">
            <Grid
                Padding="10"
                ColumnDefinitions="auto"
                ColumnSpacing="10"
                HorizontalOptions="Center"
                RowDefinitions="auto,auto">
                <!--  Current Period Buttons  -->
                <Border
                    Padding="4"
                    HorizontalOptions="Center"
                    Stroke="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1">

                    <Grid ColumnDefinitions="auto,auto,auto,auto" ColumnSpacing="2">
                        <Button
                            Grid.Column="0"
                            Padding="10,8"
                            BackgroundColor="{StaticResource PrimaryDark}"
                            CornerRadius="10"
                            FontSize="13"
                            HeightRequest="40"
                            Text="1 Week"
                            TextColor="White" />
                        <Button
                            Grid.Column="1"
                            Padding="10,8"
                            BackgroundColor="Transparent"
                            CornerRadius="10"
                            FontSize="13"
                            HeightRequest="40"
                            Text="1 Month"
                            TextColor="{StaticResource PrimaryDarkText}" />
                        <Button
                            Grid.Column="2"
                            Padding="10,8"
                            BackgroundColor="Transparent"
                            CornerRadius="10"
                            FontSize="13"
                            HeightRequest="40"
                            Text="1 Year"
                            TextColor="{StaticResource PrimaryDarkText}" />
                        <Button
                            Grid.Column="3"
                            Padding="10,8"
                            BackgroundColor="Transparent"
                            CornerRadius="10"
                            FontSize="13"
                            HeightRequest="40"
                            Text="All Time"
                            TextColor="{StaticResource PrimaryDarkText}" />

                    </Grid>
                </Border>
            </Grid>

            <Grid
                Padding="15"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="15">

                <Border
                    Grid.Row="0"
                    Padding="15"
                    BackgroundColor="White"
                    Stroke="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 18"
                    StrokeThickness="5">

                    <VerticalStackLayout Spacing="15">

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Daily Steps"
                            TextColor="{StaticResource PrimaryDarkText}" />

                        <Label
                            FontSize="13"
                            Text="Steps taken each day"
                            TextColor="{StaticResource SecondaryDarkText}" />

                        <GraphicsView
                            x:Name="StepsChart"
                            HeightRequest="230"
                            HorizontalOptions="Fill" />

                    </VerticalStackLayout>
                </Border>

                <Label
                    Grid.Row="1"
                    FontAttributes="Bold"
                    FontSize="21"
                    Text="Weekly Summary"
                    TextColor="{StaticResource PrimaryDark}" />

                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">

                    <Border
                        Grid.Column="0"
                        Padding="14"
                        BackgroundColor="{StaticResource LightTeal}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeShape="RoundRectangle 14">

                        <VerticalStackLayout Spacing="8">

                            <Image
                                Aspect="AspectFit"
                                HeightRequest="30"
                                HorizontalOptions="Start"
                                Source="footprints.svg"
                                WidthRequest="30" />

                            <Label
                                FontSize="14"
                                Text="Total steps"
                                TextColor="{StaticResource PrimaryDark}" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="24"
                                Text="82,000"
                                TextColor="{StaticResource PrimaryDark}" />

                            <Label
                                FontSize="12"
                                Text="This week"
                                TextColor="{StaticResource SecondaryDarkText}" />

                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="14"
                        BackgroundColor="{StaticResource LightTeal}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeShape="RoundRectangle 14">

                        <VerticalStackLayout Spacing="8">

                            <Image
                                Aspect="AspectFit"
                                HeightRequest="30"
                                HorizontalOptions="Start"
                                Source="footprints.svg"
                                WidthRequest="30" />

                            <Label
                                FontSize="14"
                                Text="Daily average"
                                TextColor="{StaticResource PrimaryDark}" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="24"
                                Text="11,714"
                                TextColor="{StaticResource PrimaryDark}" />

                            <Label
                                FontSize="12"
                                Text="Steps per day"
                                TextColor="{StaticResource SecondaryDarkText}" />

                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <Border
                    Grid.Row="3"
                    Padding="16"
                    BackgroundColor="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Weekly Insight"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="Your most active day was Monday!"
                            TextColor="{StaticResource PrimaryDark}" />
                        <Label
                            FontSize="14"
                            Text="You achieved your goal average of 10,000 steps for the week!"
                            TextColor="{StaticResource PrimaryDark}" />

                    </VerticalStackLayout>
                </Border>

            </Grid>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>