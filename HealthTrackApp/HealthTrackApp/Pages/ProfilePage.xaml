<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthTrackApp.Pages.ProfilePage"
             Title="Profile">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,auto"
          RowDefinitions="auto,auto"
          Padding="10"
          ColumnSpacing="10"
          HorizontalOptions="Start">
            <Label Grid.Column="0"  
               Grid.Row="0"
               Text="Your Profile"
               FontSize="18"
               FontAttributes="Bold"
               VerticalOptions="Center"
               TextColor="white"/>
            <Label Grid.Column="0"
               Grid.Row="1"  
               Text="Manage Your Personal Information"
               FontSize="10"
               FontAttributes="Bold"
               VerticalOptions="Center"
               TextColor="white"/>

        </Grid>
    </Shell.TitleView>
    <VerticalStackLayout Padding="20" Spacing="15" HorizontalOptions="Center">
        <Grid RowDefinitions="*,auto"
                Padding="10"
                ColumnSpacing="10">
            <Image Source="bigprofile.png" Aspect="AspectFit" MaximumHeightRequest="140"/>

            <Label
                Grid.Row="1"
                Text="Ryan" 
                HorizontalOptions="Center"
                FontAttributes="Bold"
                FontSize="30"
                Padding="10"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="User Details"
                 FontSize="21"
                 FontAttributes="Bold"
                 TextColor="{StaticResource PrimaryDark}"
                 HorizontalOptions="Center"/>
        </Grid>

        <Border Padding="14"
              BackgroundColor="{StaticResource CardBackground}"
              Stroke="{StaticResource BorderColor}"
              StrokeShape="RoundRectangle 14"
              MinimumWidthRequest="600">

            <VerticalStackLayout Spacing="12" >

                <Grid ColumnDefinitions="auto,auto" ColumnSpacing="20">

                    <Image Source="profile.png" Grid.Column="0"/>
                    <VerticalStackLayout Spacing="4" Grid.Column="1">
                        
                        <Label Grid.Column="1"
                            Text="Full Name"
                             TextColor="{StaticResource PrimaryDark}"/>

                        <Label Grid.Column="1"
                             Text="Ryan Turner"
                             FontAttributes="Bold"
                             FontSize="15"
                             TextColor="{StaticResource SecondaryDarkText}"/>
                    </VerticalStackLayout>

                </Grid>

                <BoxView HeightRequest="1"
                       Color="{StaticResource BorderColor}"/>


                <Grid ColumnDefinitions="auto,auto" ColumnSpacing="20">

                    <Image Source="mail.png" Grid.Column="0"/>
                    <VerticalStackLayout Spacing="4" Grid.Column="1">

                        <Label Grid.Column="1"
                            Text="Email Address"
                             TextColor="{StaticResource PrimaryDark}"/>

                        <Label Grid.Column="1"
                             Text="ryan@example.com"
                             FontAttributes="Bold"
                             FontSize="15"
                             TextColor="{StaticResource SecondaryDarkText}"/>
                    </VerticalStackLayout>

                </Grid>

                <BoxView HeightRequest="1"
                       Color="{StaticResource BorderColor}"/>

                <Grid ColumnDefinitions="auto,auto" ColumnSpacing="20">

                    <Image Source="ruler.png" Grid.Column="0"/>
                    <VerticalStackLayout Spacing="4" Grid.Column="1">

                        <Label Grid.Column="1"
                            Text="Height"
                             TextColor="{StaticResource PrimaryDark}"/>

                        <Label Grid.Column="1"
                             Text="180 cm"
                             FontAttributes="Bold"
                             FontSize="15"
                             TextColor="{StaticResource SecondaryDarkText}"/>
                    </VerticalStackLayout>

                </Grid>

                <BoxView HeightRequest="1"
                       Color="{StaticResource BorderColor}"/>

                <Grid ColumnDefinitions="auto,auto" ColumnSpacing="20">

                    <Image Source="weight.png" Grid.Column="0"/>
                    <VerticalStackLayout Spacing="4" Grid.Column="1">

                        <Label Grid.Column="1"
                            Text="Weight"
                             TextColor="{StaticResource PrimaryDark}"/>

                        <Label Grid.Column="1"
                             Text="75 Kg"
                             FontAttributes="Bold"
                             FontSize="15"
                             TextColor="{StaticResource SecondaryDarkText}"/>
                    </VerticalStackLayout>

                </Grid>

           

            </VerticalStackLayout>
        </Border>
        <Border Padding="14"
         BackgroundColor="{StaticResource Primary}"
         Stroke="{StaticResource Primary}"
         StrokeShape="RoundRectangle 14"
         >

            <Grid ColumnDefinitions="auto,auto"  HorizontalOptions="Center">

               
                <VerticalStackLayout  Grid.Column="0" HorizontalOptions="Center">

                    <Label 
                           Text="Edit Profile"
                           FontAttributes="Bold"
                           FontSize="20"
                           TextColor="{StaticResource White}"/>

                </VerticalStackLayout>
            </Grid>


        </Border>

    </VerticalStackLayout>
</ContentPage>
