<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HealthTrackApp.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Profile">

    <Shell.TitleView>
        <Grid
            Padding="10"
            ColumnDefinitions="*,auto"
            ColumnSpacing="10"
            HorizontalOptions="Start"
            RowDefinitions="auto,auto">

            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="24"
                Text="Your Profile"
                TextColor="{StaticResource Secondary}"
                VerticalOptions="Center" />


        </Grid>
    </Shell.TitleView>
    <VerticalStackLayout
        Padding="20"
        HorizontalOptions="Center"
        Spacing="15">
        <Grid
            Padding="10"
            ColumnSpacing="10"
            RowDefinitions="*,auto">
            <Image
                Aspect="AspectFit"
                MaximumHeightRequest="140"
                Source="bigprofile.png" />

            <Label
                Grid.Row="1"
                Padding="10"
                FontAttributes="Bold"
                FontSize="30"
                HorizontalOptions="Center"
                Text="Ryan" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
            <Label
                FontAttributes="Bold"
                FontSize="21"
                HorizontalOptions="Center"
                Text="User Details"
                TextColor="{StaticResource PrimaryDark}" />
        </Grid>

        <Border
            Padding="14"
            BackgroundColor="{StaticResource CardBackground}"
            MinimumWidthRequest="600"
            Stroke="{StaticResource BorderColor}"
            StrokeShape="RoundRectangle 14">

            <VerticalStackLayout Spacing="12">

                <Grid ColumnDefinitions="auto,auto" ColumnSpacing="20">

                    <Image Grid.Column="0" Source="person.png" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">

                        <Label
                            Grid.Column="1"
                            Text="Full Name"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Ryan Turner"
                            TextColor="{StaticResource SecondaryDarkText}" />
                    </VerticalStackLayout>

                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />


                <Grid ColumnDefinitions="auto,auto" ColumnSpacing="20">

                    <Image Grid.Column="0" Source="mail.png" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">

                        <Label
                            Grid.Column="1"
                            Text="Email Address"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="ryan@example.com"
                            TextColor="{StaticResource SecondaryDarkText}" />
                    </VerticalStackLayout>

                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />

                <Grid ColumnDefinitions="auto,auto" ColumnSpacing="20">

                    <Image Grid.Column="0" Source="ruler.png" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">

                        <Label
                            Grid.Column="1"
                            Text="Height"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="180 cm"
                            TextColor="{StaticResource SecondaryDarkText}" />
                    </VerticalStackLayout>

                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />

                <Grid ColumnDefinitions="auto,auto" ColumnSpacing="20">

                    <Image Grid.Column="0" Source="weight.png" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">

                        <Label
                            Grid.Column="1"
                            Text="Weight"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="75 Kg"
                            TextColor="{StaticResource SecondaryDarkText}" />
                    </VerticalStackLayout>

                </Grid>



            </VerticalStackLayout>
        </Border>

        <Button
            Padding="14"
            BackgroundColor="{StaticResource Primary}"
            Clicked="OnEditProfileButtonClicked"
            ContentLayout="Left,15"
            CornerRadius="14"
            FontAttributes="Bold"
            FontSize="20"
            HeightRequest="65"
            HorizontalOptions="Fill"
            ImageSource="pencil.png"
            Text="Edit Profile"
            TextColor="White" />



    </VerticalStackLayout>
</ContentPage>
