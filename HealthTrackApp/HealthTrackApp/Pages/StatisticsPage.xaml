<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthTrackApp.Pages.StatisticsPage"
             Title="StatisticsPage">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,auto"
          RowDefinitions="auto,auto"
          Padding="10"
          ColumnSpacing="10"
          HorizontalOptions="Start">
            <Label Grid.Column="0"  
               Grid.Row="0"
               Text="Statistics"
               FontSize="18"
               FontAttributes="Bold"
               VerticalOptions="Center"
               TextColor="white"/>
            <Label Grid.Column="0"
               Grid.Row="1"  
               Text="View your current statistics"
               FontSize="10"
               FontAttributes="Bold"
               VerticalOptions="Center"
               TextColor="white"/>

        </Grid>
    </Shell.TitleView>
    <ScrollView>
        
         <VerticalStackLayout HorizontalOptions="Center">
            <Grid RowDefinitions="auto" ColumnDefinitions="auto" Padding="10" ColumnSpacing="10" HorizontalOptions="Center">
                <!--Current Period Buttons-->
                <Border Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="4"
                    HorizontalOptions="Center">

                    <Grid ColumnDefinitions="auto,auto,auto,auto" ColumnSpacing="2">
                        <Button Grid.Column="0"
                            Text="1 Week"
                            BackgroundColor="{StaticResource PrimaryDark}"
                            TextColor="White"
                            CornerRadius="10"
                            Padding="10,8"
                            FontSize="13"
                            HeightRequest="40"/>
                        <Button Grid.Column="1"
                            Text="1 Month"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource PrimaryDarkText}"
                            CornerRadius="10"
                            Padding="10,8"
                            FontSize="13"
                            HeightRequest="40"/>
                        <Button Grid.Column="2"
                            Text="1 Year"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource PrimaryDarkText}"
                            CornerRadius="10"
                            Padding="10,8"
                            FontSize="13"
                            HeightRequest="40"/>
                        <Button Grid.Column="3"
                            Text="All Time"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource PrimaryDarkText}"
                            CornerRadius="10"
                            Padding="10,8"
                            FontSize="13"
                            HeightRequest="40"/>

                    </Grid>
                </Border>
            </Grid>

            <Grid Padding="15">
                <Border Stroke="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 18"
                        Padding="15"
                        BackgroundColor="White"
                        StrokeThickness="5">

                    <VerticalStackLayout Spacing="15">

                        <Label Text="Daily Steps"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryDarkText}"/>
                        <Label Text="Steps taken each day"
                               FontSize="13"
                               TextColor="{StaticResource SecondaryDarkText}"/>

                        <GraphicsView x:Name="StepsChart"
                                      HeightRequest="230"
                                      HorizontalOptions="Fill"/>
                    </VerticalStackLayout>

                </Border>
            </Grid>
   
      
     </VerticalStackLayout>
    </ScrollView>
</ContentPage>