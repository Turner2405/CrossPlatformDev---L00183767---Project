<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HealthTrackApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HealthTrackApp.Pages"
    Title="HealthTrackApp"
    Shell.BackgroundColor="{StaticResource PrimaryDark}"
    Shell.ForegroundColor="White"
    Shell.NavBarIsVisible="true"
    Shell.TabBarBackgroundColor="{StaticResource Secondary}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TitleColor="White">


    <Shell.TitleView>
        <Grid
            Padding="10"
            ColumnDefinitions="*,auto,auto,auto"
            ColumnSpacing="10"
            HeightRequest="70"
            HorizontalOptions="Start"
            WidthRequest="400">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="24"
                Text="HealthTrack"
                TextColor="{StaticResource Secondary}"
                VerticalOptions="Center" />

            <ImageButton
                Grid.Row="0"
                Grid.Column="4"
                Clicked="OnProfileClicked"
                HeightRequest="50"
                HorizontalOptions="End"
                Source="profile.png"
                WidthRequest="50" />
        </Grid>
    </Shell.TitleView>

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:DashBoard}"
            Icon="house.png"
            Route="DashBoard" />
        <ShellContent
            Title="Statistics"
            ContentTemplate="{DataTemplate local:StatisticsPage}"
            Icon="stats.png"
            Route="StatisticsPage" />
        <ShellContent
            Title="Goals"
            ContentTemplate="{DataTemplate local:GoalsPage}"
            Icon="goals.png"
            Route="GoalsPages" />
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Icon="settings.png"
            Route="SettingsPage" />
    </TabBar>

</Shell>